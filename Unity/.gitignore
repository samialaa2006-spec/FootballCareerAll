# Unity-only ignore rules

# Editor-generated and local data
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Build output
[Bb]uild/
[Bb]uilds/

# IDE-generated project files
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Preserve Unity metadata under this project even though the legacy web repo ignores *.meta globally.
!Assets/**/*.meta
!Packages/**/*.meta
!ProjectSettings/**/*.meta
